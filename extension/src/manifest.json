{
  "manifest_version": 3,
  "name": "Raven Application Assistant",
  "version": "2.3.1",
  "description": "Save jobs to Raven and assist with approved application autofill. Never submits applications.",
  "permissions": ["contextMenus","tabs","storage","downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker":"background.js"},
  "content_scripts": [{"matches":["<all_urls>"],"js":["assistant-core.js","prepare-content.js","content.js"],"run_at":"document_idle"},{"matches":["https://chatgpt.com/*"],"js":["chatgpt-files.js"],"run_at":"document_idle"}]
}
