{
  "theme": {
    "font-ui": "ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
    "font-display": "ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
    "font-size-xs": "0.75rem",
    "font-size-sm": "0.875rem",
    "font-size-md": "1rem",
    "font-size-lg": "1.05rem",
    "font-size-xl": "1.25rem",
    "font-weight-normal": "400",
    "font-weight-strong": "600",
    "font-weight-heavy": "650",
    "line-height": "1.5",
    "tracking-ui": "0",
    "tracking-label": "0",
    "bg": "#212121",
    "bg-grid": "transparent",
    "surface": "#2f2f2f",
    "surface-raised": "#333333",
    "surface-hover": "#383838",
    "surface-active": "#3a3a3a",
    "surface-input": "#2f2f2f",
    "text": "#ececec",
    "text-soft": "#d1d1d1",
    "text-muted": "#9b9b9b",
    "text-inverse": "#171717",
    "accent": "#ececec",
    "accent-strong": "#ffffff",
    "accent-dim": "rgba(255,255,255,.08)",
    "accent-border": "rgba(255,255,255,.16)",
    "secondary": "#cfcfcf",
    "secondary-dim": "rgba(255,255,255,.06)",
    "success": "#d7d7d7",
    "warning": "#c8c8c8",
    "danger": "#aaaaaa",
    "info": "#bdbdbd",
    "status-saved": "#bdbdbd",
    "status-ready": "#c8c8c8",
    "status-applied": "#d7d7d7",
    "status-interview": "#c8c8c8",
    "status-offer": "#e0e0e0",
    "status-rejected": "#999999",
    "status-default": "#9b9b9b",
    "status-discovered": "#bdbdbd",
    "border-color": "rgba(255,255,255,.10)",
    "border-subtle": "rgba(255,255,255,.07)",
    "border-active": "rgba(255,255,255,.20)",
    "border-width": "1px",
    "radius-xs": "8px",
    "radius-sm": "10px",
    "radius-md": "14px",
    "radius-lg": "18px",
    "corner-cut": "0px",
    "shadow-panel": "none",
    "glow-accent": "none",
    "glow-active": "none",
    "scanline-opacity": "0",
    "grid-size": "0px",
    "control-height": "42px",
    "button-height": "42px",
    "control-pad-x": "14px",
    "transition-fast": "120ms ease",
    "transition-normal": "180ms ease",
    "job-row-min-height": "0",
    "panel-padding": "14px",
    "detail-label-width": "110px"
  },
  "settings": {
    "default-sort": "added-desc",
    "card-density": "compact",
    "detail-panel-width": "1fr",
    "sidebar-width": "360px",
    "show-salary": true,
    "show-remote": true,
    "show-source": true,
    "show-notes": true,
    "show-sync-status": true,
    "empty-list-text": "No matching jobs.",
    "empty-detail-title": "Select a job",
    "empty-detail-text": "Tap a job to view its description and actions.",
    "public-site-url": "https://shipitmyguy-ux.github.io/raven/"
  },
  "ui": [
    {
      "surface": "job-card",
      "position": 1,
      "key": "title",
      "visible": true,
      "label": "Title",
      "format": "text",
      "notes": "Primary row title"
    },
    {
      "surface": "job-card",
      "position": 2,
      "key": "company",
      "visible": true,
      "label": "Company",
      "format": "text",
      "notes": "Metadata"
    },
    {
      "surface": "job-card",
      "position": 3,
      "key": "location",
      "visible": true,
      "label": "Location",
      "format": "text",
      "notes": "Metadata"
    },
    {
      "surface": "job-card",
      "position": 4,
      "key": "salaryText",
      "visible": true,
      "label": "Salary",
      "format": "text",
      "notes": "Controlled by show-salary"
    },
    {
      "surface": "job-card",
      "position": 5,
      "key": "status",
      "visible": true,
      "label": "Status",
      "format": "status",
      "notes": "Status pill"
    },
    {
      "surface": "detail",
      "position": 2,
      "key": "salaryText",
      "visible": true,
      "label": "Salary",
      "format": "text",
      "notes": "Controlled by show-salary"
    },
    {
      "surface": "detail",
      "position": 3,
      "key": "source",
      "visible": true,
      "label": "Source",
      "format": "text",
      "notes": "Controlled by show-source"
    },
    {
      "surface": "detail",
      "position": 4,
      "key": "resume",
      "visible": true,
      "label": "Resume",
      "format": "link",
      "notes": "Generated document"
    },
    {
      "surface": "detail",
      "position": 5,
      "key": "coverLetter",
      "visible": true,
      "label": "Cover letter",
      "format": "link",
      "notes": "Generated document"
    },
    {
      "surface": "detail",
      "position": 6,
      "key": "notes",
      "visible": true,
      "label": "Notes",
      "format": "multiline",
      "notes": "Controlled by show-notes"
    },
    {
      "surface": "detail-action",
      "position": 1,
      "key": "apply",
      "visible": true,
      "label": "Apply",
      "format": "external-link",
      "notes": "Job URL"
    },
    {
      "surface": "detail-action",
      "position": 2,
      "key": "resume",
      "visible": true,
      "label": "Generate resume",
      "format": "queue",
      "notes": "Controlled by feature flag"
    },
    {
      "surface": "detail-action",
      "position": 3,
      "key": "coverLetter",
      "visible": true,
      "label": "Generate cover letter",
      "format": "queue",
      "notes": "Controlled by feature flag"
    },
    {
      "surface": "detail-action",
      "position": 4,
      "key": "applicationReview",
      "visible": false,
      "label": "Application review",
      "format": "queue",
      "notes": "Controlled by feature flag"
    }
  ],
  "statuses": [
    {
      "key": "Discovered",
      "label": "Discovered",
      "colorToken": "status-discovered",
      "order": 5,
      "visible": true,
      "terminal": false,
      "notes": "Background search candidate not yet saved to the Google Sheet"
    },
    {
      "key": "Saved",
      "label": "Saved",
      "colorToken": "status-saved",
      "order": 10,
      "visible": true,
      "terminal": false,
      "notes": "Default captured state"
    },
    {
      "key": "Ready",
      "label": "Ready",
      "colorToken": "status-ready",
      "order": 20,
      "visible": true,
      "terminal": false,
      "notes": "Prepared for action"
    },
    {
      "key": "Applied",
      "label": "Applied",
      "colorToken": "status-applied",
      "order": 30,
      "visible": true,
      "terminal": false,
      "notes": "Submitted to employer"
    },
    {
      "key": "Interview",
      "label": "Interview",
      "colorToken": "status-interview",
      "order": 40,
      "visible": true,
      "terminal": false,
      "notes": "Interview stage"
    },
    {
      "key": "Offer",
      "label": "Offer",
      "colorToken": "status-offer",
      "order": 50,
      "visible": true,
      "terminal": true,
      "notes": "Offer received"
    },
    {
      "key": "Rejected",
      "label": "Rejected",
      "colorToken": "status-rejected",
      "order": 60,
      "visible": true,
      "terminal": true,
      "notes": "Closed/rejected"
    }
  ],
  "features": {
    "resume-generation": true,
    "cover-letter-generation": true,
    "application-review": true,
    "extension-download": true,
    "queue-panel": true,
    "capture-form": true,
    "search": true,
    "status-filter": true,
    "job-search-trigger": true
  }
}
