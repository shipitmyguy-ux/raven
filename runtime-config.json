{
  "theme": {
    "font-ui": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "font-display": "ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
    "font-size-xs": "0.72rem",
    "font-size-sm": "0.82rem",
    "font-size-md": "0.95rem",
    "font-size-lg": "1.08rem",
    "font-size-xl": "1.55rem",
    "font-weight-normal": "500",
    "font-weight-strong": "720",
    "font-weight-heavy": "850",
    "line-height": "1.45",
    "tracking-ui": "0.01em",
    "tracking-label": "0.08em",
    "bg": "#07090e",
    "bg-grid": "rgba(49, 244, 255, 0.035)",
    "surface": "#0c1119",
    "surface-raised": "#101824",
    "surface-hover": "#14202c",
    "surface-active": "#172936",
    "surface-input": "#090e15",
    "text": "#dff8f7",
    "text-soft": "#a3b9bc",
    "text-muted": "#70868b",
    "text-inverse": "#020607",
    "accent": "#31f4ff",
    "accent-strong": "#84fbff",
    "accent-dim": "rgba(49, 244, 255, 0.14)",
    "accent-border": "rgba(49, 244, 255, 0.34)",
    "secondary": "#ff3bd5",
    "secondary-dim": "rgba(255, 59, 213, 0.12)",
    "success": "#42f59e",
    "warning": "#ffd84a",
    "danger": "#ff5876",
    "info": "#7bb8ff",
    "status-saved": "var(--accent)",
    "status-ready": "#9a8cff",
    "status-applied": "var(--success)",
    "status-interview": "var(--warning)",
    "status-offer": "#87ff62",
    "status-rejected": "var(--danger)",
    "status-default": "var(--text-muted)",
    "border-color": "#1d303b",
    "border-subtle": "rgba(130, 176, 188, 0.16)",
    "border-active": "var(--accent-border)",
    "border-width": "1px",
    "radius-xs": "2px",
    "radius-sm": "4px",
    "radius-md": "7px",
    "radius-lg": "10px",
    "corner-cut": "10px",
    "shadow-panel": "0 16px 50px rgba(0, 0, 0, 0.28)",
    "glow-accent": "0 0 22px rgba(49, 244, 255, 0.16)",
    "glow-active": "0 0 0 1px rgba(49, 244, 255, 0.25), 0 0 22px rgba(49, 244, 255, 0.12)",
    "scanline-opacity": "0.025",
    "grid-size": "32px",
    "control-height": "40px",
    "button-height": "40px",
    "control-pad-x": "12px",
    "transition-fast": "120ms ease",
    "transition-normal": "180ms ease",
    "job-row-min-height": "70px",
    "panel-padding": "16px",
    "detail-label-width": "110px",
    "status-discovered": "var(--secondary)"
  },
  "settings": {
    "default-sort": "added-desc",
    "card-density": "compact",
    "detail-panel-width": "1fr",
    "sidebar-width": "360px",
    "show-salary": true,
    "show-remote": true,
    "show-source": true,
    "show-notes": false,
    "show-sync-status": true,
    "empty-list-text": "No matching jobs.",
    "empty-detail-title": "Select a job",
    "empty-detail-text": "Tap a job to view its description and actions.",
    "public-site-url": "https://shipitmyguy-ux.github.io/raven/"
  },
  "ui": [
    {
      "surface": "job-card",
      "position": 1,
      "key": "title",
      "visible": true,
      "label": "Title",
      "format": "text",
      "notes": "Primary row title"
    },
    {
      "surface": "job-card",
      "position": 2,
      "key": "company",
      "visible": true,
      "label": "Company",
      "format": "text",
      "notes": "Metadata"
    },
    {
      "surface": "job-card",
      "position": 3,
      "key": "location",
      "visible": true,
      "label": "Location",
      "format": "text",
      "notes": "Metadata"
    },
    {
      "surface": "job-card",
      "position": 4,
      "key": "salaryText",
      "visible": true,
      "label": "Salary",
      "format": "text",
      "notes": "Controlled by show-salary"
    },
    {
      "surface": "job-card",
      "position": 5,
      "key": "status",
      "visible": true,
      "label": "Status",
      "format": "status",
      "notes": "Status pill"
    },
    {
      "surface": "detail",
      "position": 1,
      "key": "status",
      "visible": false,
      "label": "Status",
      "format": "text",
      "notes": "Detail row"
    },
    {
      "surface": "detail",
      "position": 2,
      "key": "salaryText",
      "visible": true,
      "label": "Salary",
      "format": "text",
      "notes": "Controlled by show-salary"
    },
    {
      "surface": "detail",
      "position": 3,
      "key": "source",
      "visible": true,
      "label": "Source",
      "format": "text",
      "notes": "Controlled by show-source"
    },
    {
      "surface": "detail",
      "position": 4,
      "key": "resume",
      "visible": true,
      "label": "Resume",
      "format": "link",
      "notes": "Generated document"
    },
    {
      "surface": "detail",
      "position": 5,
      "key": "coverLetter",
      "visible": true,
      "label": "Cover letter",
      "format": "link",
      "notes": "Generated document"
    },
    {
      "surface": "detail",
      "position": 6,
      "key": "notes",
      "visible": false,
      "label": "Notes",
      "format": "multiline",
      "notes": "Controlled by show-notes"
    },
    {
      "surface": "detail-action",
      "position": 1,
      "key": "apply",
      "visible": true,
      "label": "Apply",
      "format": "external-link",
      "notes": "Job URL"
    },
    {
      "surface": "detail-action",
      "position": 2,
      "key": "resume",
      "visible": true,
      "label": "Generate resume",
      "format": "queue",
      "notes": "Controlled by feature flag"
    },
    {
      "surface": "detail-action",
      "position": 3,
      "key": "coverLetter",
      "visible": true,
      "label": "Generate cover letter",
      "format": "queue",
      "notes": "Controlled by feature flag"
    },
    {
      "surface": "detail-action",
      "position": 4,
      "key": "applicationReview",
      "visible": false,
      "label": "Application review",
      "format": "queue",
      "notes": "Controlled by feature flag"
    }
  ],
  "statuses": [
    {
      "key": "Discovered",
      "label": "Discovered",
      "colorToken": "status-discovered",
      "order": 5,
      "visible": true,
      "terminal": false,
      "notes": "Background search candidate not yet saved to the Google Sheet"
    },
    {
      "key": "Interested",
      "label": "Bookmarked",
      "colorToken": "status-interested",
      "order": 8,
      "visible": true,
      "terminal": false,
      "notes": "Saved for later review"
    },
    {
      "key": "Saved",
      "label": "Saved",
      "colorToken": "status-saved",
      "order": 10,
      "visible": true,
      "terminal": false,
      "notes": "Default captured state"
    },
    {
      "key": "Ready",
      "label": "Ready",
      "colorToken": "status-ready",
      "order": 20,
      "visible": true,
      "terminal": false,
      "notes": "Prepared for action"
    },
    {
      "key": "Applied",
      "label": "Applied",
      "colorToken": "status-applied",
      "order": 30,
      "visible": true,
      "terminal": false,
      "notes": "Submitted to employer"
    },
    {
      "key": "Interview",
      "label": "Interview",
      "colorToken": "status-interview",
      "order": 40,
      "visible": true,
      "terminal": false,
      "notes": "Interview stage"
    },
    {
      "key": "Offer",
      "label": "Offer",
      "colorToken": "status-offer",
      "order": 50,
      "visible": true,
      "terminal": true,
      "notes": "Offer received"
    },
    {
      "key": "Rejected",
      "label": "Rejected",
      "colorToken": "status-rejected",
      "order": 60,
      "visible": true,
      "terminal": true,
      "notes": "Closed/rejected"
    },
    {
      "key": "Ignored",
      "label": "Ignored",
      "colorToken": "status-default",
      "order": 70,
      "visible": true,
      "terminal": true,
      "notes": "Hidden from active consideration"
    }
  ],
  "features": {
    "resume-generation": true,
    "cover-letter-generation": true,
    "application-review": true,
    "extension-download": true,
    "queue-panel": true,
    "capture-form": true,
    "search": true,
    "status-filter": true,
    "job-search-trigger": true
  }
}
